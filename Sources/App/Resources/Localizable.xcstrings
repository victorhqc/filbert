    "Regular refresh checks opted-in providers %@." : {
      "comment" : "Every %@ except a plain duration is an interval phrase from “every %lld minutes” / “every %lld seconds”, such as “every minute” or “every 5 minutes”.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Anbieter mit automatischer Aktualisierung werden %@ geprüft." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Regular refresh checks opted-in providers %@." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "La actualización normal consulta a los proveedores activados %@." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "La actualización normal consulta a los proveedores activados %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "標準の更新では、オンにしたプロバイダを%@に確認します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A atualização regular verifica os provedores selecionados %@." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "A atualização regular verifica os fornecedores selecionados %@." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Обычное обновление проверяет выбранных провайдеров %@." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "常规刷新%@检查一次已选择的提供商。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "標準重新整理會%@檢查一次已選擇的提供者。" } }
      }
    },
    "Fast-check duration" : {
      "comment" : "Slider label: how long a provider keeps fast checks after its usage changes.",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Dauer schneller Prüfungen" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fast-check duration" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Duración de consultas rápidas" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Duración de consultas rápidas" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高速確認の継続時間" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Duração das verificações rápidas" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Duração das verificações rápidas" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Длительность быстрых проверок" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快速检查时长" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "快速檢查持續時間" } }
      }
    },
    "Smart refresh checks %1$@. After a usage change, a provider checks %2$@ for %3$@, then %4$@ for another %3$@ before returning to the slow interval." : {
      "comment" : "Every %@ except a plain duration is an interval phrase from “every %lld minutes” / “every %lld seconds”, such as “every minute” or “every 5 minutes”. %3$@ is a plain duration (“10 minutes”).",
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Die intelligente Aktualisierung prüft %1$@. Nach einer Nutzungsänderung prüft ein Anbieter %3$@ lang %2$@, danach weitere %3$@ lang %4$@, bevor er zum langsamen Intervall zurückkehrt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Smart refresh checks %1$@. After a usage change, a provider checks %2$@ for %3$@, then %4$@ for another %3$@ before returning to the slow interval." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "La actualización inteligente consulta %1$@. Tras un cambio de uso, un proveedor consulta %2$@ durante %3$@ y luego %4$@ durante %3$@ más antes de volver al intervalo lento." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "La actualización inteligente consulta %1$@. Tras un cambio de uso, un proveedor consulta %2$@ durante %3$@ y luego %4$@ durante %3$@ más antes de volver al intervalo lento." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スマート更新では%1$@に確認します。使用量が変化すると、プロバイダは%3$@間、%2$@に確認し、さらに%3$@間、%4$@に確認してから低速間隔に戻ります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A atualização inteligente verifica %1$@. Após uma mudança no uso, o provedor verifica %2$@ durante %3$@ e depois %4$@ por mais %3$@ antes de voltar ao intervalo lento." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "A atualização inteligente verifica %1$@. Após uma alteração na utilização, o fornecedor verifica %2$@ durante %3$@ e depois %4$@ durante mais %3$@ antes de voltar ao intervalo lento." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Умное обновление проверяет %1$@. После изменения использования провайдер проверяет %2$@ в течение заданного времени (%3$@), затем ещё столько же (%3$@) — %4$@, после чего возвращается к медленному интервалу." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "智能刷新%1$@检查一次。用量变化后，会在 %3$@内%2$@检查一次该提供商，然后在接下来的 %3$@内%4$@检查一次，之后恢复慢速间隔。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "智慧型重新整理會%1$@檢查一次。用量變化後，提供者會在%3$@內%2$@檢查一次，然後在接下來的%3$@內%4$@檢查一次，之後恢復慢速間隔。" } }
      }
    },
    "Selected interval: %@" : {
      "extractionState" : "manual",
