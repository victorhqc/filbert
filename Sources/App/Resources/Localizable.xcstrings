    "Choose which providers refresh automatically. Mode and intervals control how often." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Wähle, welche Anbieter automatisch aktualisiert werden. Modus und Intervalle bestimmen, wie oft." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose which providers refresh automatically. Mode and intervals control how often." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Elige qué proveedores se actualizan automáticamente. El modo y los intervalos controlan la frecuencia." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Elige qué proveedores se actualizan automáticamente. El modo y los intervalos controlan la frecuencia." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動的に更新するプロバイダを選択します。頻度はモードと間隔で決まります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha quais provedores são atualizados automaticamente. O modo e os intervalos definem a frequência." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Escolha que fornecedores são atualizados automaticamente. O modo e os intervalos definem a frequência." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите, какие провайдеры обновляются автоматически. Режим и интервалы задают частоту." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择要自动刷新的提供商。模式和间隔决定刷新频率。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇要自動重新整理的提供者。模式和間隔決定重新整理的頻率。" } }
      }
