      }
    },
    "Filbert runs %2$@ in the background to check %1$@ usage. These checks may use some of your %3$@ quota. Shorter Smart intervals can increase the number of checks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Filbert führt %2$@ im Hintergrund aus, um die Nutzung von %1$@ zu prüfen. Diese Prüfungen können einen Teil deines Kontingents bei %3$@ verbrauchen. Kürzere Intervalle im Modus „Intelligent“ können die Anzahl der Prüfungen erhöhen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Filbert runs %2$@ in the background to check %1$@ usage. These checks may use some of your %3$@ quota. Shorter Smart intervals can increase the number of checks." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Filbert ejecuta %2$@ en segundo plano para consultar el uso de %1$@. Estas consultas pueden usar parte de tu cuota de %3$@. Los intervalos inteligentes más cortos pueden aumentar el número de consultas." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Filbert ejecuta %2$@ en segundo plano para consultar el uso de %1$@. Estas consultas pueden usar parte de tu cuota de %3$@. Los intervalos inteligentes más cortos pueden aumentar el número de consultas." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Filbertは%1$@の使用量を確認するため、バックグラウンドで%2$@を実行します。これらの確認で%3$@の割り当ての一部が使われる場合があります。スマートの間隔を短くすると、確認の回数が増えることがあります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O Filbert executa %2$@ em segundo plano para verificar o uso do %1$@. Essas verificações podem consumir parte da sua cota do %3$@. Intervalos inteligentes mais curtos podem aumentar o número de verificações." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "O Filbert executa %2$@ em segundo plano para verificar a utilização do %1$@. Estas verificações podem consumir parte da sua quota do %3$@. Intervalos inteligentes mais curtos podem aumentar o número de verificações." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Filbert запускает %2$@ в фоновом режиме, чтобы проверять использование %1$@. Эти проверки могут расходовать часть квоты %3$@. Более короткие интервалы умного режима могут увеличить число проверок." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Filbert 会在后台运行 %2$@ 以检查 %1$@ 用量。这些检查可能会消耗部分 %3$@ 配额。较短的智能刷新间隔可能会增加检查次数。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Filbert會在背景執行%2$@來檢查%1$@用量。這些檢查可能會消耗部分%3$@配額。較短的智慧型間隔可能會增加檢查次數。" } }
      }
    },
