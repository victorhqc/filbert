    "Stop fast checks" : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Schnelle Prüfungen beenden" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop fast checks" } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Detener consultas rápidas" } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Detener consultas rápidas" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高速確認を停止" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar verificações rápidas" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Parar verificações rápidas" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановить быстрые проверки" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止快速检查" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停止快速檢查" } }
      }
    },
    "Stopping ends the fast checks early. Automatic refresh stays on and the normal Smart timing resumes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Damit enden die schnellen Prüfungen vorzeitig. Die automatische Aktualisierung bleibt eingeschaltet, und der normale Rhythmus der intelligenten Aktualisierung gilt wieder." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopping ends the fast checks early. Automatic refresh stays on and the normal Smart timing resumes." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Al detenerlas, las consultas rápidas terminan antes. La actualización automática sigue activada y vuelve la frecuencia normal del modo Inteligente." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Si las detienes, las consultas rápidas terminan antes. La actualización automática sigue activada y se reanuda el ritmo inteligente normal." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "停止すると高速確認が早めに終了します。自動更新はオンのままで、通常のスマートのタイミングに戻ります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Parar encerra as verificações rápidas antes do tempo. A atualização automática continua ativa e o ritmo inteligente normal é retomado." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Ao parar, as verificações rápidas terminam mais cedo. A atualização automática mantém-se ativa e o ritmo normal do modo Inteligente é retomado." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Остановка досрочно завершает быстрые проверки. Автоматическое обновление остаётся включённым, и возобновляется обычный умный режим." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止会提前结束快速检查。自动刷新保持开启，并恢复正常的智能刷新节奏。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "停止後，快速檢查會提早結束。自動重新整理會保持開啟，並恢復一般的智慧型時程。" } }
      }
    },
    "Provider limit: checks no more often than %@." : {
