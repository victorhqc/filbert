    "%1$@ runs %2$@ in the background. These checks may use some of your %3$@ quota. Shorter Smart intervals can increase the number of checks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ führt %2$@ im Hintergrund aus. Diese Prüfungen können einen Teil deines %3$@-Kontingents verbrauchen. Kürzere intelligente Intervalle können die Anzahl der Prüfungen erhöhen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ runs %2$@ in the background. These checks may use some of your %3$@ quota. Shorter Smart intervals can increase the number of checks." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ ejecuta %2$@ en segundo plano. Estas consultas pueden usar parte de tu cuota de %3$@. Los intervalos inteligentes más cortos pueden aumentar el número de consultas." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ ejecuta %2$@ en segundo plano. Estas consultas pueden usar parte de tu cuota de %3$@. Los intervalos inteligentes más cortos pueden aumentar el número de consultas." } }
