      }
    },
    "Smart refresh starts every %@. Usage changes switch that provider to every %@; three unchanged checks return it to slow." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Die intelligente Aktualisierung beginnt alle %@. Nutzungsänderungen stellen diesen Anbieter auf alle %@ um; drei unveränderte Prüfungen stellen ihn wieder langsam." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Smart refresh starts every %@. Usage changes switch that provider to every %@; three unchanged checks return it to slow." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "La actualización inteligente empieza cada %@. Los cambios de uso pasan ese proveedor a cada %@; tres consultas sin cambios lo devuelven al ritmo lento." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "La actualización inteligente empieza cada %@. Los cambios de uso pasan ese proveedor a cada %@; tres consultas sin cambios lo devuelven al ritmo lento." } }
      }
