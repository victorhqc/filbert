    "Automatic selection description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch kürzlich aktive Anbieter bevorzugen; wenn die Aktivität nachlässt, zur gespeicherten Reihenfolge zurückkehren." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Favor recently active providers automatically; as activity fades, return to saved order." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Da prioridad automática a los proveedores activos recientemente; cuando la actividad disminuya, vuelve al orden guardado." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Da prioridad automática a los proveedores activos recientemente; cuando la actividad disminuya, vuelve al orden guardado." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最近アクティブなプロバイダを自動的に優先し、アクティビティが減ると保存された順序に戻ります。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Priorizar automaticamente os provedores ativos recentemente; quando a atividade diminuir, voltar à ordem salva." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Dar prioridade automaticamente aos fornecedores ativos recentemente; quando a atividade diminuir, voltar à ordem guardada." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Автоматически отдавать предпочтение недавно активным провайдерам; когда активность спадает, возвращаться к сохранённому порядку." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动优先显示最近活跃的提供商；活跃度降低后，恢复已存储的顺序。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動優先顯示最近活躍的提供者；活動減少後，恢復已儲存的順序。" } }
      }
    },
    "Automatic selection accessibility hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch kürzlich aktive Anbieter bevorzugen; wenn die Aktivität nachlässt, zur gespeicherten Reihenfolge zurückkehren. Aktueller Anbieter in der Menüleiste: %@." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Favor recently active providers automatically; as activity fades, return to saved order. Current menu-bar provider: %@." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Da prioridad automática a los proveedores activos recientemente; cuando la actividad disminuya, vuelve al orden guardado. Proveedor actual en la barra de menús: %@." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Da prioridad automática a los proveedores activos recientemente; cuando la actividad disminuya, vuelve al orden guardado. Proveedor actual en la barra de menús: %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最近アクティブなプロバイダを自動的に優先し、アクティビティが減ると保存された順序に戻ります。現在のメニューバーのプロバイダ: %@。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Priorizar automaticamente os provedores ativos recentemente; quando a atividade diminuir, voltar à ordem salva. Provedor atual na barra de menus: %@." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Dar prioridade automaticamente aos fornecedores ativos recentemente; quando a atividade diminuir, voltar à ordem guardada. Fornecedor atual na barra de menus: %@." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Автоматически отдавать предпочтение недавно активным провайдерам; когда активность спадает, возвращаться к сохранённому порядку. Текущий провайдер в строке меню: %@." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动优先显示最近活跃的提供商；活跃度降低后，恢复已存储的顺序。当前菜单栏提供商：%@。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動優先顯示最近活躍的提供者；活動減少後，恢復已儲存的順序。目前的選單列提供者：%@。" } }
