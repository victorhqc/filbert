    "Fast and slow checks use the same interval, so fast checks are not more frequent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : { "stringUnit" : { "state" : "translated", "value" : "Schnelle und langsame Prüfungen verwenden dasselbe Intervall, daher sind schnelle Prüfungen nicht häufiger." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fast and slow checks use the same interval, so fast checks are not more frequent." } },
        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Las consultas rápidas y lentas usan el mismo intervalo, así que las consultas rápidas no son más frecuentes." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Las consultas rápidas y lentas usan el mismo intervalo, así que las consultas rápidas no son más frecuentes." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高速確認と低速確認の間隔が同じため、高速確認の頻度は上がりません。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "As verificações rápidas e lentas usam o mesmo intervalo, então as rápidas não são mais frequentes." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "As verificações rápidas e lentas usam o mesmo intervalo, pelo que as rápidas não são mais frequentes." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Быстрые и медленные проверки используют один интервал, поэтому быстрые проверки не чаще обычных." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快速检查和慢速检查使用相同的间隔，因此快速检查并不会更频繁。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "快速檢查和慢速檢查使用相同的間隔，因此快速檢查不會更頻繁。" } }
