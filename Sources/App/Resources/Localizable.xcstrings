        "es-ES" : { "stringUnit" : { "state" : "translated", "value" : "Consulta %@ durante el tiempo que elijas, aunque el uso no cambie." } },
        "es-MX" : { "stringUnit" : { "state" : "translated", "value" : "Consulta %@ durante el tiempo que elijas, aunque el uso no cambie." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "使用量が変化しなくても、選択した時間の間は%@に確認します。" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verifica %@ durante o tempo escolhido, mesmo quando o uso não muda." } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "Verifica %@ durante o tempo escolhido, mesmo quando a utilização não se altera." } },
