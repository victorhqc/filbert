        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI已登出。請打開Gemini CLI並使用Google帳戶登入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Gemini CLI returned an unexpected usage response.": {
      "localizations": {
