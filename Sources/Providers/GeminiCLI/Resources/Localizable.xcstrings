    "Allow Filbert to read the Gemini CLI Keychain item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Filbert to read the Gemini CLI Keychain item"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert erlauben, das Schlüsselbundobjekt von Gemini CLI zu lesen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que Filbert lea el elemento del llavero de Gemini CLI"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que Filbert lea el elemento del llavero de Gemini CLI"
