    "Allow Filbert to read the Gemini CLI Keychain item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Filbert to read the Gemini CLI Keychain item"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert erlauben, das Schlüsselbundobjekt von Gemini CLI zu lesen"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Filbert lea el ítem del llavero de Gemini CLI"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Filbert lea el elemento del llavero de Gemini CLI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FilbertにGemini CLIのキーチェーン項目の読み取りを許可"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o Filbert leia o item das chaves do Gemini CLI"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o Filbert leia o elemento de porta-chaves do Gemini CLI"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить Filbert читать объект связки ключей Gemini CLI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Filbert 读取 Gemini CLI 钥匙串项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許Filbert讀取Gemini CLI的鑰匙圈項目"
          }
        }
      },
      "extractionState": "manual"
    },
    "Complete Gemini CLI setup or configure a Google Cloud project, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete Gemini CLI setup or configure a Google Cloud project, then try again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte Gemini CLI ein oder konfiguriere ein Google-Cloud-Projekt und versuche es dann erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la configuración de Gemini CLI o configura un proyecto de Google Cloud y vuelve a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la configuración de Gemini CLI o configura un proyecto de Google Cloud y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLIの設定を完了するか、Google Cloudプロジェクトを設定してから、やり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a configuração do Gemini CLI ou configure um projeto do Google Cloud e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a configuração do Gemini CLI ou configure um projeto do Google Cloud e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите настройку Gemini CLI или настройте проект Google Cloud, затем повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请完成 Gemini CLI 设置或配置 Google Cloud 项目，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請完成Gemini CLI設定或設定Google Cloud專案，然後再試一次。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Filbert could not read the Gemini CLI Keychain item. Allow access and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert could not read the Gemini CLI Keychain item. Allow access and try again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert konnte das Schlüsselbundobjekt von Gemini CLI nicht lesen. Erlaube den Zugriff und versuche es erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert no ha podido leer el ítem del llavero de Gemini CLI. Permite el acceso y vuelve a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert no pudo leer el elemento del llavero de Gemini CLI. Permite el acceso y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FilbertはGemini CLIのキーチェーン項目を読み取れませんでした。アクセスを許可して、やり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Filbert não conseguiu ler o item das chaves do Gemini CLI. Permita o acesso e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Filbert não conseguiu ler o elemento de porta-chaves do Gemini CLI. Permita o acesso e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert не удалось прочитать объект связки ключей Gemini CLI. Разрешите доступ и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert 无法读取 Gemini CLI 钥匙串项。请允许访问，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert無法讀取Gemini CLI的鑰匙圈項目。請允許取用，然後再試一次。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Gemini CLI account or project setup is required.": {
      "localizations": {
