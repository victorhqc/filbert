    "Gemini CLI returned data Filbert could not read. Update Filbert and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI returned data Filbert could not read. Update Filbert and try again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI hat Daten zurückgegeben, die Filbert nicht lesen konnte. Aktualisiere Filbert und versuche es erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI ha devuelto datos que Filbert no ha podido leer. Actualiza Filbert y vuelve a intentarlo."
          }
        },
        "es-MX": {
