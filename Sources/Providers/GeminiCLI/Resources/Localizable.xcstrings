    },
    "Complete Gemini CLI setup or configure a Google Cloud project, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete Gemini CLI setup or configure a Google Cloud project, then try again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten Sie Gemini CLI ein oder konfigurieren Sie ein Google-Cloud-Projekt und versuchen Sie es erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la configuración de Gemini CLI o configura un proyecto de Google Cloud y vuelve a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa la configuración de Gemini CLI o configura un proyecto de Google Cloud y vuelve a intentarlo."
          }
        }
      },
      "extractionState": "manual"
    },
    "Filbert could not read the Gemini CLI Keychain item. Allow access and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert could not read the Gemini CLI Keychain item. Allow access and try again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert konnte das Schlüsselbundobjekt von Gemini CLI nicht lesen. Erlauben Sie den Zugriff und versuchen Sie es erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert no pudo leer el elemento del llavero de Gemini CLI. Permite el acceso y vuelve a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Filbert no pudo leer el elemento del llavero de Gemini CLI. Permite el acceso y vuelve a intentarlo."
          }
        }
