    },
    "Gemini CLI credentials are unsupported. Update Gemini CLI and sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI credentials are unsupported. Update Gemini CLI and sign in again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gemini-CLI-Anmeldedaten werden nicht unterstützt. Aktualisiere Gemini CLI und melde dich erneut an."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales de Gemini CLI no son compatibles. Actualiza Gemini CLI e inicia sesión de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales de Gemini CLI no son compatibles. Actualiza Gemini CLI e inicia sesión de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このGemini CLIの認証情報には対応していません。Gemini CLIをアップデートして、もう一度サインインしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais do Gemini CLI não são compatíveis. Atualize o Gemini CLI e inicie sessão novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais do Gemini CLI não são suportadas. Atualize o Gemini CLI e inicie sessão novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётные данные Gemini CLI не поддерживаются. Обновите Gemini CLI и войдите снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此 Gemini CLI 凭证。请更新 Gemini CLI，然后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此Gemini CLI憑證。請更新Gemini CLI，然後重新登入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Gemini CLI is rate limited. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI is rate limited. Try again later."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI hat das Anfragelimit erreicht. Versuche es später erneut."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha alcanzado el límite de frecuencia de Gemini CLI. Vuelve a intentarlo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de frecuencia de Gemini CLI. Vuelve a intentarlo más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLIのリクエストの上限に達しました。あとでやり直してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini CLI atingiu o limite de solicitações. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gemini CLI atingiu o limite de pedidos. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов к Gemini CLI. Повторите попытку позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI 请求过于频繁。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI已達速率限制。請稍後再試一次。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Gemini CLI is signed out. Open Gemini CLI and sign in with Google.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI is signed out. Open Gemini CLI and sign in with Google."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini CLI ist abgemeldet. Öffne Gemini CLI und melde dich mit Google an."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha cerrado la sesión de Gemini CLI. Abre Gemini CLI e inicia sesión con Google."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerró la sesión de Gemini CLI. Abre Gemini CLI e inicia sesión con Google."
          }
