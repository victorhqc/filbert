    "Trust Filbert's two hooks with /hooks in the Codex CLI, or in Settings > Hooks in the Codex app. If hooks are off in Codex, turn them on first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraue den zwei Hooks von Filbert mit /hooks in der Codex CLI oder unter „Settings > Hooks“ in der Codex-App. Wenn Hooks in Codex deaktiviert sind, aktiviere sie zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trust Filbert's two hooks with /hooks in the Codex CLI, or in Settings > Hooks in the Codex app. If hooks are off in Codex, turn them on first."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía en los dos hooks de Filbert con /hooks en la CLI de Codex o en «Settings > Hooks» de la app de Codex. Si los hooks están desactivados en Codex, actívalos primero."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía en los dos hooks de Filbert con /hooks en la CLI de Codex o en “Settings > Hooks” de la app de Codex. Si los hooks están desactivados en Codex, actívalos primero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex CLIの/hooks、またはCodexアプリの“Settings > Hooks”で、Filbertの2つのフックを信頼してください。Codexでフックがオフになっている場合は、先にオンにしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie nos dois hooks do Filbert com /hooks na CLI do Codex ou em “Settings > Hooks” no app do Codex. Se os hooks estiverem desativados no Codex, ative-os primeiro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie nos dois hooks do Filbert com /hooks na CLI do Codex ou em «Settings > Hooks» na app do Codex. Se os hooks estiverem desativados no Codex, ative-os primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите доверие двум хукам Filbert командой /hooks в Codex CLI или в разделе «Settings > Hooks» приложения Codex. Если хуки в Codex выключены, сначала включите их."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 Codex CLI 中的 /hooks，或在 Codex 应用的“Settings > Hooks”中信任 Filbert 的两个 hook。如果 Codex 中的 hook 已关闭，请先将其开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用Codex CLI中的「/hooks」，或在Codex應用程式的「Settings > Hooks」中信任Filbert的兩個hook。如果Codex中的hook已關閉，請先開啟。"
          }
        }
      }
    },
