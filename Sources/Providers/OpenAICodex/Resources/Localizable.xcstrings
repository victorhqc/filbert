    "Filbert can't update %@ because it isn't a hooks file Filbert recognizes. The file was not changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filbert kann %@ nicht ändern, weil das Format der Hooks-Datei unbekannt ist. Die Datei wurde nicht geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filbert can't update %@ because it isn't a hooks file Filbert recognizes. The file was not changed."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filbert no puede modificar %@ porque no reconoce el formato del archivo de hooks. El archivo no se ha modificado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filbert no puede modificar %@ porque no reconoce el formato del archivo de hooks. El archivo no se modificó."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filbertが認識できるフックファイルではないため、%@を変更できません。ファイルは変更されていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Filbert não pode alterar %@ porque não reconhece o formato do arquivo de hooks. O arquivo não foi alterado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
