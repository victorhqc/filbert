<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  No App Sandbox — the app spawns subprocesses (claude, codex) and reads
  Keychain items it creates at runtime, both incompatible with sandbox.
  Ad-hoc and Developer ID builds use the same file so the keychain default
  access group stays stable across dev and release.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
